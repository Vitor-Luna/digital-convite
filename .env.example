# ============================================================================
#  Copie este arquivo para `.env` e preencha os valores.
#  cp .env.example .env
# ============================================================================

# --- Banco de dados -----------------------------------------------------------
# DESENVOLVIMENTO: rode `npm run db:start` (Postgres real embutido, sem Docker)
# e use a URL abaixo tal como está.
# PRODUÇÃO: use a connection string do seu Postgres gerenciado.
#   Neon:     postgresql://USER:PASSWORD@HOST/db?sslmode=require
#   Supabase: postgresql://postgres:PASSWORD@HOST:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bes"

# --- Autenticação do painel dos noivos --------------------------------------
# Senha única de acesso ao /admin.
ADMIN_PASSWORD="defina-uma-senha-forte"

# Segredo do cookie de sessão (mínimo 32 caracteres).
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="gere-um-segredo-aleatorio-de-32-caracteres-ou-mais"

# Dias até a sessão do admin expirar (opcional, padrão 30).
SESSION_TTL_DAYS="30"
